{
    "chat.disableAIFeatures": true,
    "chat.extensionUnification.enabled": false,
    "github.copilot.chat.agent.currentEditorContext.enabled": false,
    // Python environment (flat layout)
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.autoSearchPaths": true,
    // Ruff - linting and formatting
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },
    "[objective-cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },
    "ruff.path": [
        "${workspaceFolder}/.venv/bin/ruff"
    ],
    "ruff.lint.enable": true,
    "ruff.importStrategy": "fromEnvironment",
    // BasedPyright - type checking
    "basedpyright.analysis.typeCheckingMode": "standard",
    "basedpyright.analysis.diagnosticSeverityOverrides": {},
    // Testing with pytest
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests",
        "mega_taxonomy"
    ],
    // Editor settings for Python
    "editor.rulers": [
        100
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // File associations
    "files.associations": {
        "*.py": "python",
        "pyproject.toml": "toml"
    },
    // Search exclusions
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "**/dist": true,
        "**/build": true,
        "**/.ruff_cache": true,
        "**/uv.lock": true
    },
    // Files to exclude from explorer
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true
    },
    "cursorpyright.analysis.autoSearchPaths": true,
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src",
        "${workspaceFolder}/build-cpp-omp",
        "${workspaceFolder}/build-cpp",
        "${workspaceFolder}/.venv/lib/python3.13/site-packages/torch/include",
        "${workspaceFolder}/.venv/lib/python3.13/site-packages/torch/include/torch/csrc/api/include",
        "/Users/duoan/.local/share/uv/python/cpython-3.13.9-macos-aarch64-none/include/python3.13"
    ],
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "C_Cpp.default.cppStandard": "c++17",
    "clang-format.executable": "/opt/homebrew/bin/clang-format",
    "clang-format.style": "file",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build-cpp-omp",
        "--header-insertion=never"
    ],
    "clangd.fallbackFlags": [
        "-I${workspaceFolder}/include",
        "-I${workspaceFolder}/src",
        "-I${workspaceFolder}/.venv/lib/python3.13/site-packages/torch/include",
        "-I${workspaceFolder}/.venv/lib/python3.13/site-packages/torch/include/torch/csrc/api/include",
        "-I/Users/duoan/.local/share/uv/python/cpython-3.13.9-macos-aarch64-none/include/python3.13",
        "-std=c++17"
    ]
}
